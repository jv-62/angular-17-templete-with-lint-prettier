{
  "name": "prettier-lint-setup",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prettier-format": "prettier --config .prettierrc.json src/app/ --ignore-path .prettierignore --write",
    "lint": "ng lint --ignore-path .eslintignore --fix"
